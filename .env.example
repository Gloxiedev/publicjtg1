# =============================================================
# JTG Panel configuration
# =============================================================
# Copy to .env and adjust. install.sh writes these automatically and
# generates a real JWT_SECRET for you; never commit .env.
#
# install.sh picks the correct values for each exposure mode:
#   --exposure cloudflare  BIND_ADDRESS=127.0.0.1, TRUST_PROXY=true,
#                          PANEL_URL/CORS_ORIGINS set to https://your-domain
#   --exposure direct      BIND_ADDRESS=0.0.0.0, TRUST_PROXY=false
#   --exposure later       BIND_ADDRESS=127.0.0.1, TRUST_PROXY=false

# --- Network ----------------------------------------------------------------

# Port the panel listens on.
PORT="6767"

# Interface to bind.
#   127.0.0.1  only reachable from this host (correct behind a Cloudflare Tunnel)
#   0.0.0.0    reachable from the network (only if you firewall the port)
BIND_ADDRESS="127.0.0.1"

# How many proxy hops in front of the panel to trust for X-Forwarded-* headers.
#   false      trust nothing; req.secure is always false and req.ip is the proxy
#   true       trust the first hop only (correct for a single cloudflared or nginx)
#   loopback   trust only requests arriving over loopback
# Enabling this without a real proxy in front lets clients spoof X-Forwarded-For.
TRUST_PROXY="false"

# Public base URL of this panel, e.g. https://panel.example.com
# Required for correct install commands when behind a proxy, because Host and
# X-Forwarded-Host can otherwise be spoofed. Must be https:// or http://.
PANEL_URL=""

# Browser origins allowed to call the panel API, comma separated.
# Defaults to PANEL_URL when set. Leave empty for same-origin only.
CORS_ORIGINS=""

# --- Security ---------------------------------------------------------------

# REQUIRED in production. Must be at least 32 characters and must NOT be the
# value that used to be hardcoded in this repository.
#   openssl rand -hex 32
# The panel refuses to start in production if this is missing, too short, or
# still the published default -- that check is an auth bypass guard.
JWT_SECRET="your-secure-random-jwt-secret-here"

# --- Runtime ----------------------------------------------------------------

# true  run game servers in Docker (recommended; host Java not required)
# false run game servers as local processes
DEFAULT_RUNTIME="docker"
ENABLE_DOCKER="true"
DOCKER_SOCKET_PATH="/var/run/docker.sock"

# --- Optional ---------------------------------------------------------------

# Gemini API key, kept server side. Never exposed to the browser.
GEMINI_API_KEY=""

# Development-only passwordless login. Ignored when NODE_ENV=production.
DEV_AUTH_BYPASS="false"
