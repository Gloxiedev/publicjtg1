# Never commit private keys or certificates. A leaked *.pem is a full account
# takeover, and the environment variable here matches the exposed Rexa.pem
# incident that prompted these rules.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der

# Cloudflare tunnel credentials and installer artefacts
.credentials.json
cert.pem
cloudflared.yml
.wrangler/
.tunnels/

# Ecosystem config regenerated by installers on some hosts
ecosystem.production.cjs
